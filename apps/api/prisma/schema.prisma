generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus { ACTIVE SUSPENDED DELETED }
enum MembershipStatus { PENDING ACTIVE SUSPENDED EXPIRED CANCELLED }
enum DueStatus { OPEN PARTIALLY_PAID PAID OVERDUE CANCELLED }
enum PaymentStatus { PENDING REQUIRES_ACTION AUTHORIZED PAID FAILED CANCELLED REFUNDED PARTIALLY_REFUNDED DISPUTED }
enum TicketStatus { ISSUED ACTIVE USED CANCELLED EXPIRED TRANSFERRED }
enum TicketTransferStatus { PENDING ACCEPTED DECLINED CANCELLED EXPIRED }
enum EntryScanResult { ACCEPTED REJECTED ALREADY_USED EXPIRED CANCELLED }

model Tenant {
  id String @id @default(uuid()) @db.Uuid
  slug String @unique @db.VarChar(80)
  name String @db.VarChar(160)
  status String @default("active") @db.VarChar(32)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  settings TenantSettings?
  userTenants UserTenant[]
  sessions UserSession[]
  members Member[]
  memberships Membership[]
  dues Due[]
  payments PaymentTransaction[]
  receipts Receipt[]
  auditLogs AuditLog[]
  competitions Competition[]
  teams Team[]
  fixtures Fixture[]
  articles Article[]
  ticketAccounts TicketAccount[]
  ticketEvents TicketEvent[]
  tickets Ticket[]
  ticketTransfers TicketTransfer[]
  entryScans EntryScan[]
  @@index([status])
  @@map("tenants")
}

model TenantSettings {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @unique @db.Uuid
  logoUrl String?
  logoDarkUrl String?
  heroImageUrl String?
  appIconUrl String?
  primaryColor String @default("#008C45") @db.VarChar(9)
  secondaryColor String @default("#005B2A") @db.VarChar(9)
  accentColor String @default("#D7E83F") @db.VarChar(9)
  backgroundColor String @default("#07110D") @db.VarChar(9)
  surfaceColor String @default("#102019") @db.VarChar(9)
  textColor String @default("#FFFFFF") @db.VarChar(9)
  mutedTextColor String @default("#A7B5AE") @db.VarChar(9)
  slogan String? @db.VarChar(255)
  shortName String? @db.VarChar(80)
  defaultLocale String @default("pt-PT") @db.VarChar(10)
  enabledFeatures Json?
  homeConfiguration Json?
  socialLinks Json?
  legalLinks Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@map("tenant_settings")
}

model User {
  id String @id @default(uuid()) @db.Uuid
  email String? @unique @db.VarChar(320)
  phone String? @db.VarChar(32)
  passwordHash String?
  status UserStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userTenants UserTenant[]
  member Member?
  sessions UserSession[]
  auditLogs AuditLog[]
  tickets Ticket[]
  ticketTransfersSent TicketTransfer[] @relation("TicketTransferSender")
  ticketTransfersReceived TicketTransfer[] @relation("TicketTransferRecipient")
  @@index([status])
  @@map("users")
}

model UserTenant {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  tenantId String @db.Uuid
  roles String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@unique([userId, tenantId])
  @@index([tenantId, userId])
  @@map("user_tenants")
}

model UserSession {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  tenantId String @db.Uuid
  refreshTokenHash String @unique @db.VarChar(128)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  lastUsedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
  @@index([tenantId, expiresAt])
  @@map("user_sessions")
}

model Member {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  userId String? @unique @db.Uuid
  memberNumber String @db.VarChar(80)
  firstName String @db.VarChar(120)
  lastName String @db.VarChar(120)
  email String? @db.VarChar(320)
  phone String? @db.VarChar(32)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  memberships Membership[]
  dues Due[]
  tickets Ticket[]
  @@unique([tenantId, memberNumber])
  @@index([tenantId, email])
  @@index([tenantId, phone])
  @@map("members")
}

model Membership {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  memberId String @db.Uuid
  planCode String @db.VarChar(80)
  status MembershipStatus @default(PENDING)
  validFrom DateTime
  validUntil DateTime?
  externalId String? @db.VarChar(160)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  @@unique([tenantId, externalId])
  @@index([tenantId, memberId, status])
  @@map("memberships")
}

model Due {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  memberId String @db.Uuid
  reference String @db.VarChar(120)
  description String? @db.VarChar(255)
  amount Decimal @db.Decimal(12, 2)
  paidAmount Decimal @default(0) @db.Decimal(12, 2)
  currency String @default("EUR") @db.Char(3)
  dueDate DateTime
  status DueStatus @default(OPEN)
  externalId String? @db.VarChar(160)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  payments PaymentTransaction[]
  @@unique([tenantId, externalId])
  @@index([tenantId, memberId, status, dueDate])
  @@map("dues")
}

model PaymentTransaction {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  dueId String? @db.Uuid
  provider String @db.VarChar(40)
  providerPaymentId String? @db.VarChar(255)
  idempotencyKey String @db.VarChar(255)
  amount Decimal @db.Decimal(12, 2)
  currency String @default("EUR") @db.Char(3)
  status PaymentStatus @default(PENDING)
  paidAt DateTime?
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  due Due? @relation(fields: [dueId], references: [id], onDelete: SetNull)
  receipt Receipt?
  @@unique([tenantId, idempotencyKey])
  @@unique([provider, providerPaymentId])
  @@index([tenantId, status, createdAt])
  @@map("payment_transactions")
}

model Receipt {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  paymentTransactionId String @unique @db.Uuid
  receiptNumber String @db.VarChar(120)
  externalId String? @db.VarChar(160)
  issuedAt DateTime
  amount Decimal @db.Decimal(12, 2)
  currency String @db.Char(3)
  documentUrl String?
  metadata Json?
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paymentTransaction PaymentTransaction @relation(fields: [paymentTransactionId], references: [id], onDelete: Cascade)
  @@unique([tenantId, receiptNumber])
  @@index([tenantId, issuedAt])
  @@map("receipts")
}

model Competition {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  externalId String @db.VarChar(160)
  provider String @default("mock") @db.VarChar(40)
  name String @db.VarChar(160)
  country String? @db.VarChar(120)
  season String? @db.VarChar(80)
  logoUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fixtures Fixture[]
  @@unique([tenantId, provider, externalId])
  @@index([tenantId, name])
  @@map("competitions")
}

model Team {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  externalId String @db.VarChar(160)
  provider String @default("mock") @db.VarChar(40)
  name String @db.VarChar(160)
  shortName String? @db.VarChar(80)
  logoUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  homeFixtures Fixture[] @relation("FixtureHomeTeam")
  awayFixtures Fixture[] @relation("FixtureAwayTeam")
  @@unique([tenantId, provider, externalId])
  @@index([tenantId, name])
  @@map("teams")
}

model Fixture {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  externalId String @db.VarChar(160)
  provider String @default("mock") @db.VarChar(40)
  competitionId String? @db.Uuid
  homeTeamId String @db.Uuid
  awayTeamId String @db.Uuid
  kickoffAt DateTime
  status String @default("SCHEDULED") @db.VarChar(40)
  venueName String? @db.VarChar(160)
  venueCity String? @db.VarChar(120)
  homeScore Int?
  awayScore Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  competition Competition? @relation(fields: [competitionId], references: [id], onDelete: SetNull)
  homeTeam Team @relation("FixtureHomeTeam", fields: [homeTeamId], references: [id], onDelete: Restrict)
  awayTeam Team @relation("FixtureAwayTeam", fields: [awayTeamId], references: [id], onDelete: Restrict)
  ticketEvents TicketEvent[]
  @@unique([tenantId, provider, externalId])
  @@index([tenantId, kickoffAt])
  @@index([tenantId, homeTeamId, kickoffAt])
  @@index([tenantId, awayTeamId, kickoffAt])
  @@map("fixtures")
}

model Article {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  slug String @db.VarChar(180)
  title String @db.VarChar(255)
  excerpt String? @db.VarChar(500)
  body String
  imageUrl String?
  category String? @db.VarChar(80)
  publishedAt DateTime?
  isPublished Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@unique([tenantId, slug])
  @@index([tenantId, isPublished, publishedAt])
  @@map("articles")
}

model TicketAccount {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  provider String @default("mock") @db.VarChar(40)
  externalAccountId String @db.VarChar(160)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tickets Ticket[]
  @@unique([tenantId, provider, externalAccountId])
  @@index([tenantId])
  @@map("ticket_accounts")
}

model TicketEvent {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  fixtureId String? @db.Uuid
  externalId String? @db.VarChar(160)
  name String @db.VarChar(200)
  startsAt DateTime
  endsAt DateTime?
  venueName String? @db.VarChar(160)
  venueAddress String? @db.VarChar(255)
  status String @default("SCHEDULED") @db.VarChar(40)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fixture Fixture? @relation(fields: [fixtureId], references: [id], onDelete: SetNull)
  tickets Ticket[]
  @@unique([tenantId, externalId])
  @@index([tenantId, startsAt])
  @@map("ticket_events")
}

model Ticket {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  eventId String @db.Uuid
  ticketAccountId String?
  userId String?
  memberId String?
  provider String @default("mock") @db.VarChar(40)
  externalTicketId String @db.VarChar(160)
  ticketNumber String? @db.VarChar(120)
  status TicketStatus @default(ISSUED)
  holderName String? @db.VarChar(200)
  section String? @db.VarChar(80)
  row String? @db.VarChar(40)
  seat String? @db.VarChar(40)
  qrTokenHash String? @unique @db.VarChar(128)
  issuedAt DateTime @default(now())
  validFrom DateTime?
  validUntil DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  event TicketEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketAccount TicketAccount? @relation(fields: [ticketAccountId], references: [id], onDelete: SetNull)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  member Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  transfers TicketTransfer[]
  scans EntryScan[]
  @@unique([tenantId, provider, externalTicketId])
  @@index([tenantId, userId, status])
  @@index([tenantId, memberId, status])
  @@index([tenantId, eventId, status])
  @@map("tickets")
}

model TicketTransfer {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  ticketId String @db.Uuid
  fromUserId String @db.Uuid
  toUserId String @db.Uuid
  status TicketTransferStatus @default(PENDING)
  expiresAt DateTime?
  acceptedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fromUser User @relation("TicketTransferSender", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser User @relation("TicketTransferRecipient", fields: [toUserId], references: [id], onDelete: Cascade)
  @@index([tenantId, ticketId, status])
  @@index([tenantId, toUserId, status])
  @@map("ticket_transfers")
}

model EntryScan {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  ticketId String @db.Uuid
  scannerId String? @db.Uuid
  result EntryScanResult
  scannedAt DateTime @default(now())
  deviceId String? @db.VarChar(160)
  metadata Json?
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  @@index([tenantId, ticketId, scannedAt])
  @@index([tenantId, result, scannedAt])
  @@map("entry_scans")
}

model AuditLog {
  id String @id @default(uuid()) @db.Uuid
  tenantId String? @db.Uuid
  userId String? @db.Uuid
  action String @db.VarChar(120)
  resource String @db.VarChar(120)
  resourceId String? @db.VarChar(120)
  metadata Json?
  ipAddress String? @db.VarChar(64)
  createdAt DateTime @default(now())
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}
